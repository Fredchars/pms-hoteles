# Secretos de la mini web de reservas (Streamlit Cloud → Settings → Secrets). NO subir el archivo real al repositorio.
DATABASE_URL = "postgresql://USUARIO:CLAVE@HOST:6543/postgres"   # la misma base del PMS (en producción: un rol con permisos mínimos)
PMS_SESION_SECRETO = "cadena-aleatoria-larga-1"     # firma de enlaces; si cambia, los enlaces enviados antes dejan de funcionar
PMS_PASARELA_SECRETO = "cadena-aleatoria-larga-2"   # firma del «webhook» de la pasarela simulada
PMS_WEB_URL = "https://pms-reservas-atm.streamlit.app"
PMS_ENTORNO = "produccion"
# Opcional (correo real): se envía SOLO a las direcciones de la lista PMS_CORREO_PERMITIDOS. Sin esto el correo es simulado.
# PMS_CORREO_PROVEEDOR = "resend"           # o "brevo"
# PMS_CORREO_API_KEY = "..."
# PMS_CORREO_REMITENTE = "reservas@tu-dominio.com"
# PMS_CORREO_PERMITIDOS = "prueba@tu-dominio.com"
