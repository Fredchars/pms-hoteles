# Copia este archivo como .streamlit/secrets.toml (local) o pégalo en Streamlit Community Cloud > Settings > Secrets.
# NUNCA subas el archivo real al repositorio.
DATABASE_URL = "postgresql://USUARIO:CLAVE@HOST:6543/postgres"   # cadena del pooler de Supabase
PMS_SESION_SECRETO = "una-frase-larga-y-aleatoria"                # firma de la sesión
PMS_MODO_DEMO = "no"                                              # "si" solo en pruebas; en producción debe ser "no"
PMS_ENTORNO = "produccion"                                        # con "produccion" el acceso demo queda apagado siempre
